generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CHILD
  THERAPIST
  ADMIN
}

enum ExerciseType {
  story
  chat
  cloze
  feelings
  why
  reactions
}

enum ExerciseGroupType {
  generic
  cloze
  feelings
  why
  reactions
}

enum ExerciseGroupStatus {
  completed
  available
  blocked
}

// Users
model User {
  id       String  @id @default(uuid())
  username String  @unique
  email    String? @unique
  password String
  name     String
  surname  String
  role     Role    @default(CHILD)
  googleAccessToken    String?
  googleRefreshToken   String?
  googleTokenExpiresAt BigInt?

  therapist Therapist?
  child     Child?
}

model Therapist {
  userId String @id
  user   User   @relation(fields: [userId], references: [id])

  children  Child[]
  feedbacks Feedback[]
  appointments Appointment[]
}

model Child {
  userId String @id
  user   User   @relation(fields: [userId], references: [id])

  age         Int
  gender      String
  ethnicity   String
  description String?
  diagnosis   String?  
  internalNotes String? // visible to the therapist only

  coins Int @default(0)

  progressResetAt DateTime? // set when the therapist resets the child's progress

  avatarSkinColor String @default("#ffffff")
  avatarHairStyle String @default("man_1")
  avatarHairColor String @default("#ffffff")
  avatarEyes      String @default("eyes_1")
  avatarClothes   String @default("clothes_1")
  avatarMouth     String @default("mouth_1")

  therapistId String
  therapist   Therapist @relation(fields: [therapistId], references: [userId])

  paths         Path[]
  attempts      ExerciseAttempt[]
  unlockedItems CollectionItem[]
  feedbacks     Feedback[]
  appointments Appointment[]
}

model Feedback {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  therapistId String
  therapist   Therapist @relation(fields: [therapistId], references: [userId])

  childId String
  child   Child  @relation(fields: [childId], references: [userId])
}

// Exercises
model Path {
  id String @id @default(uuid())

  childId String
  child   Child  @relation(fields: [childId], references: [userId])

  exerciseGroupId String
  exerciseGroup   ExerciseGroup @relation(fields: [exerciseGroupId], references: [id])

  status   ExerciseGroupStatus
  position Int

  @@unique([childId, exerciseGroupId])
}

model ExerciseGroup {
  id        String             @id @default(uuid())
  title     String
  topic     String
  groupType ExerciseGroupType  @default(generic)
  exercises Exercise[]
  paths     Path[]
  appointments Appointment[]
}

model Exercise {
  id           String        @id @default(uuid())
  contentJson  Json
  position     Int
  exerciseType ExerciseType

  groupId String
  group   ExerciseGroup @relation(fields: [groupId], references: [id])

  attempts ExerciseAttempt[]
}

model ExerciseAttempt {
  id String @id @default(uuid())

  childId String
  child   Child  @relation(fields: [childId], references: [userId])

  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])

  success          Boolean
  durationSeconds  Int
  triesTillCorrect Int?
  textAttempt      Json?
  mode             String   @default("training") // "training" or "testing"
  
  createdAt DateTime @default(now())
}

// Parrot book
model CollectionItem {
  id      String @id @default(uuid())
  name    String
  imageId String
  price   Int

  children Child[]
}


model Appointment {
  id          String   @id @default(uuid())
  startTime   DateTime
  type        String   // "training" or "testing"
  duration    String   // e.g. "45 min"
  note        String?

  // Number of exercise groups to complete in the session
  trainingExercises Int @default(0)
  testingExercises  Int @default(0)

  prescribedGroups ExerciseGroup[]

  therapistId String
  therapist   Therapist @relation(fields: [therapistId], references: [userId])

  childId     String
  child       Child     @relation(fields: [childId], references: [userId])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}