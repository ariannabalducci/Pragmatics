# PostgreSQL (DIRECT_URL is used by Prisma for schema changes)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/praggymatics"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/praggymatics"

# Signs the session tokens issued at login
JWT_SECRET=""

# Azure OpenAI (Praggy chatbot and therapist assistant)
AZURE_OPENAI_ENDPOINT="https://<your-resource>.openai.azure.com/"
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT="gpt-4o"

# Google OAuth (therapist sign-in and Calendar sync)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
